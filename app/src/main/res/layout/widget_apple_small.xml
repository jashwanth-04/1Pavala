<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_apple_card_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Brand / Context Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_circle_badge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1PAVALA"
            android:textColor="#8E8E93"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Balance Display -->
    <TextView
        android:id="@+id/txt_small_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="₹10,000"
        android:textColor="#1C1C1E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_small_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remaining budget"
        android:textColor="#34C759"
        android:textSize="10sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tactile 1-Tap Add Action Button -->
    <LinearLayout
        android:id="@+id/btn_small_add_expense"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/widget_apple_button_bg"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/add_expense"
            android:src="@drawable/ic_widget_plus" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Expense"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
