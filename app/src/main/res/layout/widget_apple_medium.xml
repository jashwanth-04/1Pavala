<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_apple_card_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- LEFT COLUMN: Apple-style Glanceable Metric & Gauge -->
    <LinearLayout
        android:id="@+id/widget_left_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Header / Category Tag -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/widget_circle_badge" />

            <TextView
                android:id="@+id/txt_medium_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONTHLY BUDGET"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Glanceable Balance Display -->
        <TextView
            android:id="@+id/txt_medium_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="₹10,000"
            android:textColor="#1C1C1E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Status & Context Label -->
        <TextView
            android:id="@+id/txt_medium_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Remaining available"
            android:textColor="#34C759"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1Pavala • Private"
            android:textColor="#AEAEB2"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Subtle Hairline Vertical Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="#10000000" />

    <!-- RIGHT COLUMN: Fast 1-Tap Entry Primary Action -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Primary Tactile 1-Tap Expense Button -->
        <LinearLayout
            android:id="@+id/btn_medium_add_expense"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/widget_apple_button_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/add_expense"
                android:src="@drawable/ic_widget_plus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Record Expense"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Micro helper caption -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Tap to log instantly"
            android:textColor="#8E8E93"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
